(= (check-r11 $c)
   (match &self (ClaimFund $c $fund)
      (if (emergency $c)
          (Result R11 pass (stv 1.0 0.85) (detail (reason emergency_exempt)))
          (if (has-fact (ReferralFund $fund))
              (if (has-fact (ReferralRef $c $_))
                  (Result R11 pass (stv 1.0 0.85) (detail (reason attached)))
                  (Result R11 warn (stv 0.65 0.6) (detail (reason missing) (fix attach-referral))))
              (Result R11 pass (stv 1.0 0.85) (detail (reason not_required)))))))
