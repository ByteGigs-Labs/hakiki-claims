(= (check-r3 $c)
   (match &self (ClaimService $c $s)
      (if (has-fact (Service $s))
          (if (has-fact (PreauthRequired $s))
              (if (has-fact (PreauthRef $c $_))
                  (Result R3 pass (stv 1.0 0.9) (detail (reason attached)))
                  (Result R3 fail (stv 0.95 0.92) (detail (reason missing) (fix attach-preauth))))
              (Result R3 pass (stv 1.0 0.9) (detail (reason not_required))))
          (Result R3 skip (stv 0.0 0.0) (detail (reason unknown_service))))))
