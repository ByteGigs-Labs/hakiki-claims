(= (check-r5 $c)
   (match &self (, (ClaimService $c $s) (ClaimFacility $c $fac))
      (if (has-fact (Service $s))
          (if (has-fact (Facility $fac $_))
              (match &self (, (Facility $fac $level) (MinLevel $s $required))
                 (if (>= $level $required)
                     (Result R5 pass (stv 1.0 0.9) (detail (reason level_ok) (level $level) (required $required)))
                     (Result R5 fail (stv 0.9 0.9)
                        (detail (reason level_low) (level $level) (required $required) (fix route-to-facility $required)))))
              (Result R5 skip (stv 0.0 0.0) (detail (reason unknown_facility))))
          (Result R5 skip (stv 0.0 0.0) (detail (reason unknown_service))))))
