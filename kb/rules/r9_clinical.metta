(= (check-r9 $c)
   (match &self (ClaimService $c $s)
      (if (has-fact (Service $s))
          (if (has-fact (IcdCode $c $_))
              (if (has-fact (IcdRestricted $s))
                  (match &self (, (IcdCode $c $code) (IcdCategory $c $category))
                     (if (has-fact (IcdOk $s $category))
                         (Result R9 pass (stv 1.0 0.7) (detail (reason consistent) (icd $code)))
                         (Result R9 warn (stv 0.6 0.6) (detail (reason inconsistent) (icd $code)))))
                  (Result R9 pass (stv 1.0 0.7) (detail (reason not_restricted))))
              (Result R9 skip (stv 0.0 0.0) (detail (reason no_diagnosis))))
          (Result R9 skip (stv 0.0 0.0) (detail (reason unknown_service))))))
